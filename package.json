{
  "name": "valters",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 8080",
    "build": "npm run build:cloudflare",
    "preview": "VITE_CLOUDFLARE=1 vite preview --host 127.0.0.1 --port 8080",
    "typecheck": "tsc --noEmit",
    "dev:cloudflare": "VITE_CLOUDFLARE=1 vite dev",
    "build:cloudflare": "VITE_CLOUDFLARE=1 vite build",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:visual": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "build:node": "VITE_CLOUDFLARE=0 vite build",
    "test:deploy": "node scripts/check-deploy.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/router-plugin": "^1.168.0",
    "@vitejs/plugin-react": "^5.2.0",
    "lucide-react": "^0.510.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261024.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.23.15",
    "wrangler": "^4.152.0"
  }
}

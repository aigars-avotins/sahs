{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valters-sahs",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": { "bindings": [{ "name": "CHESS_CACHE", "class_name": "ChessCache" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChessCache"] }],
  "observability": { "enabled": true }
}
